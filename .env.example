SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
LASTFM_API_KEY=your_lastfm_api_key_here

SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SPRING_R2DBC_URL=r2dbc:h2:file:///./data/musicfinder;DB_CLOSE_DELAY=-1
SPRING_R2DBC_USERNAME=sa
SPRING_R2DBC_PASSWORD=

# Number of trusted reverse proxies in front of the app. 0 ignores X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Writes ranking CSV files to debug-rankings/ when true.
DEBUG_RANKINGS_ENABLED=false

# Optional error alerts. Paste the DSN from a Sentry project to turn them on.
SENTRY_DSN=